#!/usr/bin/env python3
"""Install, inspect, or remove keel skills from a machine."""

from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

CLI_NAME = "keel"
SKILL_MD = "SKILL.md"


def repo_root() -> Path:
    env = os.environ.get("KEEL_ROOT")
    if env:
        return Path(env).expanduser().resolve()
    return Path(__file__).resolve().parent.parent


def list_agents(root: Path | None = None) -> list[Path]:
    agents = (root or repo_root()) / "agents"
    if not agents.is_dir():
        return []
    return sorted(
        path
        for path in agents.iterdir()
        if path.is_file() and path.suffix == ".md"
    )


def grok_agent_dest(home: Path, src: Path) -> Path:
    return home / ".grok" / "agents" / src.name


def list_skills(root: Path | None = None) -> list[Path]:
    skills = (root or repo_root()) / "skills"
    if not skills.is_dir():
        raise FileNotFoundError(f"找不到 {skills}")
    found = sorted(
        path
        for path in skills.iterdir()
        if path.is_dir() and (path / SKILL_MD).is_file()
    )
    if not found:
        raise FileNotFoundError(f"{skills} 下没有 SKILL.md")
    return found


def home_dir() -> Path:
    env = os.environ.get("KEEL_HOME")
    if env:
        return Path(env).expanduser().resolve()
    return Path.home()


@dataclass(frozen=True)
class Host:
    name: str
    detect: Path
    parent: Path
    required: bool = False


def hosts(home: Path) -> tuple[Host, ...]:
    library = home / ".local" / "share" / "agent-skills" / "library"
    return (
        Host("library", library, library, required=True),
        Host("grok", home / ".grok", home / ".grok" / "skills"),
        Host("claude", home / ".claude", home / ".claude" / "skills"),
        Host("cursor", home / ".cursor", home / ".cursor" / "skills"),
        Host("codex", home / ".codex", home / ".codex" / "skills"),
        Host("pi", home / ".pi" / "agent", home / ".pi" / "agent" / "skills"),
    )


def _same_skill(dest: Path, src: Path) -> bool:
    dest_md = dest / SKILL_MD
    src_md = src / SKILL_MD
    if not dest_md.is_file() or not src_md.is_file():
        return False
    try:
        if dest.resolve() == src.resolve():
            return True
    except OSError:
        pass
    try:
        return dest_md.read_bytes() == src_md.read_bytes()
    except OSError:
        return False


def _same_file(dest: Path, src: Path) -> bool:
    if dest.is_dir() or src.is_dir() or not src.is_file():
        return False
    if not dest.exists() and not dest.is_symlink():
        return False
    try:
        if dest.is_file() and dest.resolve() == src.resolve():
            return True
    except OSError:
        pass
    try:
        return dest.is_file() and dest.read_bytes() == src.read_bytes()
    except OSError:
        return False


def _is_our_link(dest: Path, src: Path) -> bool:
    if not dest.is_symlink():
        return False
    try:
        return dest.resolve() == src.resolve()
    except OSError:
        return False


def link_or_copy(src: Path, dest: Path, *, copy: bool) -> str:
    dest.parent.mkdir(parents=True, exist_ok=True)
    src_res = src.resolve()
    if dest.is_symlink() or dest.exists():
        if _is_our_link(dest, src_res) or _same_skill(dest, src_res):
            if copy and dest.is_symlink():
                dest.unlink()
            elif not copy and dest.is_symlink() and dest.resolve() == src_res:
                return "ok"
            elif not copy and dest.exists() and not dest.is_symlink():
                if _same_skill(dest, src_res):
                    return "ok"
        elif dest.exists() or dest.is_symlink():
            if not _is_our_link(dest, src_res) and not _same_skill(dest, src_res):
                return "skip-exists"
        if dest.is_symlink():
            dest.unlink()
        elif dest.is_dir():
            shutil.rmtree(dest)
        elif dest.exists():
            dest.unlink()
    if copy:
        shutil.copytree(src_res, dest)
        return "copy"
    try:
        dest.symlink_to(src_res, target_is_directory=True)
        return "symlink"
    except OSError:
        shutil.copytree(src_res, dest)
        return "copy"


def link_or_copy_file(src: Path, dest: Path, *, copy: bool) -> str:
    dest.parent.mkdir(parents=True, exist_ok=True)
    src_res = src.resolve()
    if dest.is_symlink() or dest.exists():
        if _is_our_link(dest, src_res) or _same_file(dest, src_res):
            if copy and dest.is_symlink():
                dest.unlink()
            elif not copy and dest.is_symlink():
                try:
                    if dest.resolve() == src_res:
                        return "ok"
                except OSError:
                    dest.unlink()
            elif dest.is_file() and _same_file(dest, src_res):
                return "ok"
        else:
            return "skip-exists"
        if dest.is_symlink() or dest.is_file():
            dest.unlink()
        else:
            return "skip-exists"
    if copy:
        shutil.copy2(src_res, dest)
        return "copy"
    try:
        dest.symlink_to(src_res)
        return "symlink"
    except OSError:
        shutil.copy2(src_res, dest)
        return "copy"


def _frontmatter_field(path: Path, key: str) -> str | None:
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return None
    if not text.startswith("---"):
        return None
    end = text.find("\n---", 3)
    if end < 0:
        return None
    prefix = f"{key}:"
    for line in text[3:end].splitlines():
        stripped = line.strip()
        if stripped.startswith(prefix):
            return stripped.split(":", 1)[1].strip().strip('"').strip("'") or None
    return None


def _agent_status_line(dest: Path, src: Path) -> str:
    if _is_our_link(dest, src) or _same_file(dest, src):
        kind = "symlink" if dest.is_symlink() else "copy"
        model = _frontmatter_field(dest, "model")
        extra = f" model={model}" if model else " 未绑模型（继承父会话）"
        return f"grok-agent/{src.stem}: {kind} {dest}{extra}"
    if dest.exists() or dest.is_symlink():
        name = _frontmatter_field(dest, "name")
        mode = _frontmatter_field(dest, "permission_mode")
        model = _frontmatter_field(dest, "model")
        if name == "reviewer" or mode == "plan":
            extra = f" model={model}" if model else " 未绑模型"
            return f"grok-agent/{src.stem}: 本机已有 {dest}{extra}"
        return f"grok-agent/{src.stem}: ⚠ 占用且不是 keel {dest}"
    return f"grok-agent/{src.stem}: 未安装 → keel install"


def remove_mount(dest: Path, src: Path) -> str:
    if not dest.exists() and not dest.is_symlink():
        return "absent"
    if _is_our_link(dest, src) or _same_skill(dest, src) or _same_file(dest, src):
        if dest.is_symlink():
            dest.unlink()
        elif dest.is_dir():
            shutil.rmtree(dest)
        else:
            dest.unlink()
        return "removed"
    return "skip-foreign"


def install_bin(script: Path, bin_dir: Path, *, copy: bool) -> str:
    bin_dir.mkdir(parents=True, exist_ok=True)
    dest = bin_dir / CLI_NAME
    src = script.resolve()
    if dest.is_symlink() or dest.exists():
        if dest.is_symlink():
            try:
                if dest.resolve() == src:
                    return "ok"
            except OSError:
                pass
            dest.unlink()
        elif dest.exists():
            try:
                if dest.read_bytes() == src.read_bytes():
                    return "ok"
            except OSError:
                return "skip-exists"
            return "skip-exists"
    if copy:
        shutil.copy2(src, dest)
        dest.chmod(0o755)
        return "copy"
    try:
        dest.symlink_to(src)
        return "symlink"
    except OSError:
        shutil.copy2(src, dest)
        dest.chmod(0o755)
        return "copy"


def remove_bin(script: Path, bin_dir: Path) -> str:
    dest = bin_dir / CLI_NAME
    if not dest.exists() and not dest.is_symlink():
        return "absent"
    src = script.resolve()
    if dest.is_symlink():
        try:
            if dest.resolve() == src:
                dest.unlink()
                return "removed"
        except OSError:
            pass
        return "skip-foreign"
    try:
        if dest.is_file() and dest.read_bytes() == src.read_bytes():
            dest.unlink()
            return "removed"
    except OSError:
        pass
    return "skip-foreign"


def refresh_local_skill() -> str | None:
    exe = shutil.which("local-skill")
    if not exe:
        return None
    result = subprocess.run(
        [exe, "refresh"],
        check=False,
        capture_output=True,
        text=True,
    )
    text = (result.stdout or result.stderr or "").strip()
    if result.returncode != 0:
        return f"local-skill refresh 失败: {text or result.returncode}"
    return text or "local-skill refresh 完成"


def install_plugin(root: Path) -> str:
    exe = shutil.which("grok")
    if not exe:
        return "skip: 未找到 grok"
    result = subprocess.run(
        [exe, "plugin", "install", str(root), "--trust"],
        check=False,
        capture_output=True,
        text=True,
    )
    text = (result.stdout or result.stderr or "").strip()
    if result.returncode != 0:
        return f"失败: {text or result.returncode}"
    return text or "ok"


def command_install(args: argparse.Namespace) -> int:
    home = Path(args.home).resolve() if args.home else home_dir()
    root = repo_root()
    skills = list_skills(root)
    lines = [f"source: {root / 'skills'} ({len(skills)})"]
    for skill in skills:
        for host in hosts(home):
            if not host.required and not host.detect.is_dir():
                continue
            dest = host.parent / skill.name
            how = link_or_copy(skill, dest, copy=args.copy)
            if how == "skip-exists":
                lines.append(f"{host.name}/{skill.name}: skip {dest}（已存在且不是 keel）")
            else:
                lines.append(f"{host.name}/{skill.name}: {how} → {dest}")
    grok_home = home / ".grok"
    if grok_home.is_dir():
        for agent in list_agents(root):
            dest = grok_agent_dest(home, agent)
            how = link_or_copy_file(agent, dest, copy=args.copy)
            if how == "skip-exists":
                lines.append(f"grok-agent/{agent.stem}: skip {dest}（已存在且不是 keel）")
            else:
                lines.append(f"grok-agent/{agent.stem}: {how} → {dest}")
    bin_dir = Path(args.bin_dir).expanduser() if args.bin_dir else home / ".local" / "bin"
    how = install_bin(Path(__file__), bin_dir, copy=args.copy)
    if how == "skip-exists":
        lines.append(f"bin: skip {bin_dir / CLI_NAME}（已存在且不是本 CLI）")
    else:
        lines.append(f"bin: {how} → {bin_dir / CLI_NAME}")
    refreshed = refresh_local_skill()
    if refreshed:
        lines.append(refreshed)
    if args.plugin:
        lines.append(f"plugin: {install_plugin(root)}")
    for line in lines:
        print(line)
    return 0


def command_uninstall(args: argparse.Namespace) -> int:
    home = Path(args.home).resolve() if args.home else home_dir()
    skills = list_skills()
    lines: list[str] = []
    for skill in skills:
        for host in hosts(home):
            dest = host.parent / skill.name
            how = remove_mount(dest, skill)
            if how == "absent" and not host.required and not host.detect.is_dir():
                continue
            lines.append(f"{host.name}/{skill.name}: {how} {dest}")
    grok_home = home / ".grok"
    for agent in list_agents():
        dest = grok_agent_dest(home, agent)
        how = remove_mount(dest, agent)
        if how == "absent" and not grok_home.is_dir():
            continue
        lines.append(f"grok-agent/{agent.stem}: {how} {dest}")
    if not args.keep_bin:
        bin_dir = Path(args.bin_dir).expanduser() if args.bin_dir else home / ".local" / "bin"
        lines.append(f"bin: {remove_bin(Path(__file__), bin_dir)} {bin_dir / CLI_NAME}")
    refreshed = refresh_local_skill()
    if refreshed:
        lines.append(refreshed)
    for line in lines:
        print(line)
    return 0


def command_doctor(args: argparse.Namespace) -> int:
    home = Path(args.home).resolve() if args.home else home_dir()
    root = repo_root()
    lines = [f"root: {root}"]
    try:
        skills = list_skills(root)
        lines.append("skills: " + " ".join(path.name for path in skills))
    except FileNotFoundError as exc:
        lines.append(f"source: ⚠ {exc}")
        for line in lines:
            print(line)
        return 1
    library_missing = True
    for skill in skills:
        for host in hosts(home):
            dest = host.parent / skill.name
            if _is_our_link(dest, skill) or _same_skill(dest, skill):
                kind = "symlink" if dest.is_symlink() else "copy"
                lines.append(f"{host.name}/{skill.name}: {kind} {dest}")
                if host.name == "library":
                    library_missing = False
            elif dest.exists() or dest.is_symlink():
                lines.append(f"{host.name}/{skill.name}: ⚠ 占用且不是 keel {dest}")
                if host.name == "library":
                    library_missing = False
            elif host.required:
                lines.append(f"{host.name}/{skill.name}: 未安装 → keel install")
            elif host.detect.is_dir():
                lines.append(f"{host.name}/{skill.name}: 未安装 → keel install")
    if library_missing:
        lines.append("library: 未安装 → keel install")
    grok_home = home / ".grok"
    agents = list_agents(root)
    if grok_home.is_dir():
        if not agents:
            lines.append("grok-agent: 仓库没有 agents/*.md")
        for agent in agents:
            lines.append(_agent_status_line(grok_agent_dest(home, agent), agent))
    elif agents:
        lines.append("grok-agent: 未探测到 ~/.grok")
    bin_dir = Path(args.bin_dir).expanduser() if args.bin_dir else home / ".local" / "bin"
    dest = bin_dir / CLI_NAME
    if dest.is_symlink() or dest.exists():
        try:
            resolved = dest.resolve()
        except OSError:
            resolved = dest
        lines.append(f"bin: {dest} → {resolved}")
    else:
        lines.append(f"bin: 未安装 → keel install  ({bin_dir / CLI_NAME})")
    exe = shutil.which("local-skill")
    lines.append("local-skill: " + (exe or "未在 PATH"))
    for line in lines:
        print(line)
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="keel",
        description="把 keel 路由与环节 skill 安装到本机 coding agent 与 local-skill 库。",
    )
    parser.add_argument("--home", help="覆盖家目录（测试用；也可用 KEEL_HOME）")
    parser.add_argument("--bin-dir", help="CLI 安装目录，默认 ~/.local/bin")
    sub = parser.add_subparsers(dest="command", required=True)

    install = sub.add_parser("install", help="挂载全部 skill 并安装 CLI")
    install.add_argument("--copy", action="store_true", help="复制文件，不建符号链接")
    install.add_argument("--plugin", action="store_true", help="同时 grok plugin install --trust")
    install.set_defaults(handler=command_install)

    uninstall = sub.add_parser("uninstall", help="只移除 keel 自己挂上的链接或副本")
    uninstall.add_argument("--keep-bin", action="store_true", help="保留 ~/.local/bin/keel")
    uninstall.set_defaults(handler=command_uninstall)

    doctor = sub.add_parser("doctor", help="只读检查挂载状态")
    doctor.set_defaults(handler=command_doctor)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return int(args.handler(args))
    except FileNotFoundError as exc:
        print(str(exc), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
