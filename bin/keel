#!/usr/bin/env python3
"""Install, inspect, or remove the keel skill from a machine."""

from __future__ import annotations

import argparse
import os
import shutil
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path

SKILL_NAME = "keel"
SKILL_MD = "SKILL.md"


def repo_root() -> Path:
    env = os.environ.get("KEEL_ROOT")
    if env:
        return Path(env).expanduser().resolve()
    return Path(__file__).resolve().parent.parent


def skill_source(root: Path | None = None) -> Path:
    path = (root or repo_root()) / "skills" / SKILL_NAME
    if not (path / SKILL_MD).is_file():
        raise FileNotFoundError(f"找不到 {path / SKILL_MD}")
    return path


def home_dir() -> Path:
    env = os.environ.get("KEEL_HOME")
    if env:
        return Path(env).expanduser().resolve()
    return Path.home()


@dataclass(frozen=True)
class Mount:
    name: str
    detect: Path
    dest: Path
    required: bool = False


def mounts(home: Path) -> tuple[Mount, ...]:
    library = home / ".local" / "share" / "agent-skills" / "library" / SKILL_NAME
    return (
        Mount("library", library.parent, library, required=True),
        Mount("grok", home / ".grok", home / ".grok" / "skills" / SKILL_NAME),
        Mount("claude", home / ".claude", home / ".claude" / "skills" / SKILL_NAME),
        Mount("cursor", home / ".cursor", home / ".cursor" / "skills" / SKILL_NAME),
        Mount("codex", home / ".codex", home / ".codex" / "skills" / SKILL_NAME),
        Mount("pi", home / ".pi" / "agent", home / ".pi" / "agent" / "skills" / SKILL_NAME),
    )


def _same_skill(dest: Path, src: Path) -> bool:
    dest_md = dest / SKILL_MD
    src_md = src / SKILL_MD
    if not dest_md.is_file() or not src_md.is_file():
        return False
    try:
        if dest.resolve() == src.resolve():
            return True
    except OSError:
        pass
    try:
        return dest_md.read_bytes() == src_md.read_bytes()
    except OSError:
        return False


def _is_our_link(dest: Path, src: Path) -> bool:
    if not dest.is_symlink():
        return False
    try:
        return dest.resolve() == src.resolve()
    except OSError:
        return False


def link_or_copy(src: Path, dest: Path, *, copy: bool) -> str:
    dest.parent.mkdir(parents=True, exist_ok=True)
    src_res = src.resolve()
    if dest.is_symlink() or dest.exists():
        if _is_our_link(dest, src_res) or _same_skill(dest, src_res):
            if copy and dest.is_symlink():
                dest.unlink()
            elif not copy and dest.is_symlink() and dest.resolve() == src_res:
                return "ok"
            elif not copy and dest.exists() and not dest.is_symlink():
                if _same_skill(dest, src_res):
                    return "ok"
        elif dest.exists() or dest.is_symlink():
            if not _is_our_link(dest, src_res) and not _same_skill(dest, src_res):
                return "skip-exists"
        if dest.is_symlink():
            dest.unlink()
        elif dest.is_dir():
            shutil.rmtree(dest)
        elif dest.exists():
            dest.unlink()
    if copy:
        shutil.copytree(src_res, dest)
        return "copy"
    try:
        dest.symlink_to(src_res, target_is_directory=True)
        return "symlink"
    except OSError:
        shutil.copytree(src_res, dest)
        return "copy"


def remove_mount(dest: Path, src: Path) -> str:
    if not dest.exists() and not dest.is_symlink():
        return "absent"
    if _is_our_link(dest, src) or _same_skill(dest, src):
        if dest.is_symlink():
            dest.unlink()
        elif dest.is_dir():
            shutil.rmtree(dest)
        else:
            dest.unlink()
        return "removed"
    return "skip-foreign"


def install_bin(script: Path, bin_dir: Path, *, copy: bool) -> str:
    bin_dir.mkdir(parents=True, exist_ok=True)
    dest = bin_dir / SKILL_NAME
    src = script.resolve()
    if dest.is_symlink() or dest.exists():
        if dest.is_symlink():
            try:
                if dest.resolve() == src:
                    return "ok"
            except OSError:
                pass
            dest.unlink()
        elif dest.exists():
            try:
                if dest.read_bytes() == src.read_bytes():
                    return "ok"
            except OSError:
                return "skip-exists"
            return "skip-exists"
    if copy:
        shutil.copy2(src, dest)
        dest.chmod(0o755)
        return "copy"
    try:
        dest.symlink_to(src)
        return "symlink"
    except OSError:
        shutil.copy2(src, dest)
        dest.chmod(0o755)
        return "copy"


def remove_bin(script: Path, bin_dir: Path) -> str:
    dest = bin_dir / SKILL_NAME
    if not dest.exists() and not dest.is_symlink():
        return "absent"
    src = script.resolve()
    if dest.is_symlink():
        try:
            if dest.resolve() == src:
                dest.unlink()
                return "removed"
        except OSError:
            pass
        return "skip-foreign"
    try:
        if dest.is_file() and dest.read_bytes() == src.read_bytes():
            dest.unlink()
            return "removed"
    except OSError:
        pass
    return "skip-foreign"


def refresh_local_skill() -> str | None:
    exe = shutil.which("local-skill")
    if not exe:
        return None
    result = subprocess.run(
        [exe, "refresh"],
        check=False,
        capture_output=True,
        text=True,
    )
    text = (result.stdout or result.stderr or "").strip()
    if result.returncode != 0:
        return f"local-skill refresh 失败: {text or result.returncode}"
    return text or "local-skill refresh 完成"


def install_plugin(root: Path) -> str:
    exe = shutil.which("grok")
    if not exe:
        return "skip: 未找到 grok"
    result = subprocess.run(
        [exe, "plugin", "install", str(root), "--trust"],
        check=False,
        capture_output=True,
        text=True,
    )
    text = (result.stdout or result.stderr or "").strip()
    if result.returncode != 0:
        return f"失败: {text or result.returncode}"
    return text or "ok"


def command_install(args: argparse.Namespace) -> int:
    home = Path(args.home).resolve() if args.home else home_dir()
    root = repo_root()
    src = skill_source(root)
    lines = [f"source: {src}"]
    for mount in mounts(home):
        if not mount.required and not mount.detect.is_dir():
            continue
        how = link_or_copy(src, mount.dest, copy=args.copy)
        if how == "skip-exists":
            lines.append(f"{mount.name}: skip {mount.dest}（已存在且不是 keel）")
        else:
            lines.append(f"{mount.name}: {how} → {mount.dest}")
    bin_dir = Path(args.bin_dir).expanduser() if args.bin_dir else home / ".local" / "bin"
    how = install_bin(Path(__file__), bin_dir, copy=args.copy)
    if how == "skip-exists":
        lines.append(f"bin: skip {bin_dir / SKILL_NAME}（已存在且不是本 CLI）")
    else:
        lines.append(f"bin: {how} → {bin_dir / SKILL_NAME}")
    refreshed = refresh_local_skill()
    if refreshed:
        lines.append(refreshed)
    if args.plugin:
        lines.append(f"plugin: {install_plugin(root)}")
    for line in lines:
        print(line)
    return 0


def command_uninstall(args: argparse.Namespace) -> int:
    home = Path(args.home).resolve() if args.home else home_dir()
    src = skill_source()
    lines: list[str] = []
    for mount in mounts(home):
        how = remove_mount(mount.dest, src)
        lines.append(f"{mount.name}: {how} {mount.dest}")
    if not args.keep_bin:
        bin_dir = Path(args.bin_dir).expanduser() if args.bin_dir else home / ".local" / "bin"
        lines.append(f"bin: {remove_bin(Path(__file__), bin_dir)} {bin_dir / SKILL_NAME}")
    refreshed = refresh_local_skill()
    if refreshed:
        lines.append(refreshed)
    for line in lines:
        print(line)
    return 0


def command_doctor(args: argparse.Namespace) -> int:
    home = Path(args.home).resolve() if args.home else home_dir()
    root = repo_root()
    lines = [f"root: {root}"]
    try:
        src = skill_source(root)
        lines.append(f"source: {src}")
    except FileNotFoundError as exc:
        lines.append(f"source: ⚠ {exc}")
        for line in lines:
            print(line)
        return 1
    for mount in mounts(home):
        dest = mount.dest
        if _is_our_link(dest, src) or _same_skill(dest, src):
            kind = "symlink" if dest.is_symlink() else "copy"
            lines.append(f"{mount.name}: {kind} {dest}")
        elif dest.exists() or dest.is_symlink():
            lines.append(f"{mount.name}: ⚠ 占用且不是 keel {dest}")
        elif mount.required:
            lines.append(f"{mount.name}: 未安装 → keel install")
        elif mount.detect.is_dir():
            lines.append(f"{mount.name}: 未安装 → keel install")
        else:
            lines.append(f"{mount.name}: 未探测到 {mount.detect}")
    bin_dir = Path(args.bin_dir).expanduser() if args.bin_dir else home / ".local" / "bin"
    dest = bin_dir / SKILL_NAME
    if dest.is_symlink() or dest.exists():
        try:
            resolved = dest.resolve()
        except OSError:
            resolved = dest
        lines.append(f"bin: {dest} → {resolved}")
    else:
        lines.append(f"bin: 未安装 → keel install  ({bin_dir / SKILL_NAME})")
    exe = shutil.which("local-skill")
    lines.append("local-skill: " + (exe or "未在 PATH"))
    for line in lines:
        print(line)
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="keel",
        description="把 keel skill 安装到本机 coding agent 与 local-skill 库。",
    )
    parser.add_argument("--home", help="覆盖家目录（测试用；也可用 KEEL_HOME）")
    parser.add_argument("--bin-dir", help="CLI 安装目录，默认 ~/.local/bin")
    sub = parser.add_subparsers(dest="command", required=True)

    install = sub.add_parser("install", help="挂载 skill 并安装 CLI")
    install.add_argument("--copy", action="store_true", help="复制文件，不建符号链接")
    install.add_argument("--plugin", action="store_true", help="同时 grok plugin install --trust")
    install.set_defaults(handler=command_install)

    uninstall = sub.add_parser("uninstall", help="只移除 keel 自己挂上的链接或副本")
    uninstall.add_argument("--keep-bin", action="store_true", help="保留 ~/.local/bin/keel")
    uninstall.set_defaults(handler=command_uninstall)

    doctor = sub.add_parser("doctor", help="只读检查挂载状态")
    doctor.set_defaults(handler=command_doctor)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return int(args.handler(args))
    except FileNotFoundError as exc:
        print(str(exc), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
