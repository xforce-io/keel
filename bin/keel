#!/usr/bin/env python3
"""Install, inspect, or remove keel skills from a machine."""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from dataclasses import dataclass, field
from pathlib import Path

CLI_NAME = "keel"
SKILL_MD = "SKILL.md"
STATE_RELATIVE = Path(".config") / "keel" / "state.json"
REVIEW_CONTRACT_SKILL = "code-review"

ABSENT = "absent"
OURS = "ours"
FOREIGN = "foreign"


def isKeelCheckout(root: Path) -> bool:
    return (root / "bin" / CLI_NAME).is_file() and (root / "skills").is_dir()


def homeDir(override: str | None) -> Path:
    if override:
        return Path(override).expanduser().resolve()
    env = os.environ.get("KEEL_HOME")
    if env:
        return Path(env).expanduser().resolve()
    return Path.home()


@dataclass
class State:
    """Machine-local record of what keel copied; symlinks identify themselves."""

    path: Path
    root: str | None = None
    copies: set[str] = field(default_factory=set)

    @classmethod
    def load(cls, home: Path) -> "State":
        path = home / STATE_RELATIVE
        if not path.is_file():
            return cls(path=path)
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError) as exc:
            raise RuntimeError(f"Corrupt keel state file {path}: {exc}") from exc
        return cls(path=path, root=data.get("root"), copies=set(data.get("copies", [])))

    def save(self) -> None:
        self.path.parent.mkdir(parents=True, exist_ok=True)
        payload = {"root": self.root, "copies": sorted(self.copies)}
        self.path.write_text(json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")

    def delete(self) -> None:
        if self.path.is_file():
            self.path.unlink()

    def isCopy(self, dest: Path) -> bool:
        return str(dest) in self.copies


def repoRoot(state: State) -> Path:
    env = os.environ.get("KEEL_ROOT")
    if env:
        root = Path(env).expanduser().resolve()
        if not isKeelCheckout(root):
            raise FileNotFoundError(f"KEEL_ROOT={root} is not a keel checkout (needs bin/keel and skills/)")
        return root
    adjacent = Path(__file__).resolve().parent.parent
    if isKeelCheckout(adjacent):
        return adjacent
    if state.root:
        recorded = Path(state.root)
        if isKeelCheckout(recorded):
            return recorded
        raise FileNotFoundError(
            f"Recorded keel checkout {recorded} (from {state.path}) is gone; "
            "re-run <checkout>/bin/keel install or set KEEL_ROOT"
        )
    raise FileNotFoundError(
        f"{Path(__file__).resolve()} is not inside a keel checkout; run <checkout>/bin/keel install or set KEEL_ROOT"
    )


def listAgents(root: Path) -> list[Path]:
    agents = root / "agents"
    if not agents.is_dir():
        return []
    return sorted(path for path in agents.iterdir() if path.is_file() and path.suffix == ".md")


def grokAgentDest(home: Path, src: Path) -> Path:
    return home / ".grok" / "agents" / src.name


def listSkills(root: Path) -> list[Path]:
    skills = root / "skills"
    if not skills.is_dir():
        raise FileNotFoundError(f"Missing skills directory {skills}")
    found = sorted(path for path in skills.iterdir() if path.is_dir() and (path / SKILL_MD).is_file())
    if not found:
        raise FileNotFoundError(f"No SKILL.md found under {skills}")
    return found


@dataclass(frozen=True)
class Host:
    name: str
    detect: Path
    parent: Path
    required: bool = False


def hosts(home: Path) -> tuple[Host, ...]:
    library = home / ".local" / "share" / "agent-skills" / "library"
    return (
        Host("library", library, library, required=True),
        Host("grok", home / ".grok", home / ".grok" / "skills"),
        Host("claude", home / ".claude", home / ".claude" / "skills"),
        Host("cursor", home / ".cursor", home / ".cursor" / "skills"),
        Host("codex", home / ".codex", home / ".codex" / "skills"),
        Host("pi", home / ".pi" / "agent", home / ".pi" / "agent" / "skills"),
    )


def linkTarget(dest: Path) -> Path:
    target = Path(os.readlink(dest))
    return target if target.is_absolute() else dest.parent / target


def _pointsIntoKeel(dest: Path, src: Path, kind: str) -> bool:
    """A live symlink is ours when it targets <any keel checkout>/<kind>/<same name>."""
    target = linkTarget(dest)
    try:
        if target.resolve() == src.resolve():
            return True
    except OSError:
        return False
    return target.name == src.name and target.parent.name == kind and isKeelCheckout(target.parent.parent)


def ownership(dest: Path, src: Path, kind: str, state: State) -> str:
    if not dest.exists() and not dest.is_symlink():
        return ABSENT
    if dest.is_symlink():
        # A dangling link protects nothing; reclaim it instead of blocking the install.
        if not dest.exists():
            return OURS
        return OURS if _pointsIntoKeel(dest, src, kind) else FOREIGN
    return OURS if state.isCopy(dest) else FOREIGN


def removePath(dest: Path) -> None:
    if dest.is_symlink() or dest.is_file():
        dest.unlink()
    elif dest.is_dir():
        shutil.rmtree(dest)


def _symlink(src: Path, dest: Path) -> None:
    try:
        dest.symlink_to(src, target_is_directory=src.is_dir())
    except OSError as exc:
        raise OSError(f"Cannot create symlink {dest} -> {src}: {exc}; re-run with --copy") from exc


def mount(src: Path, dest: Path, kind: str, state: State, *, copy: bool) -> str:
    own = ownership(dest, src, kind, state)
    if own == FOREIGN:
        return "skip-exists"
    src = src.resolve()
    if own == OURS:
        if not copy and dest.is_symlink() and dest.exists() and dest.resolve() == src:
            return "ok"
        removePath(dest)
        state.copies.discard(str(dest))
    dest.parent.mkdir(parents=True, exist_ok=True)
    if copy:
        if src.is_dir():
            shutil.copytree(src, dest)
        else:
            shutil.copy2(src, dest)
            if kind == "bin":
                dest.chmod(0o755)
        state.copies.add(str(dest))
        return "copy"
    _symlink(src, dest)
    return "symlink"


def unmount(dest: Path, src: Path, kind: str, state: State) -> str:
    own = ownership(dest, src, kind, state)
    if own == ABSENT:
        return "absent"
    if own == FOREIGN:
        return "skip-foreign"
    removePath(dest)
    state.copies.discard(str(dest))
    return "removed"


def frontmatterField(path: Path, key: str) -> str | None:
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return None
    if not text.startswith("---"):
        return None
    end = text.find("\n---", 3)
    if end < 0:
        return None
    prefix = f"{key}:"
    for line in text[3:end].splitlines():
        stripped = line.strip()
        if stripped.startswith(prefix):
            return stripped.split(":", 1)[1].strip().strip('"').strip("'") or None
    return None


def isLocalReviewerRole(dest: Path) -> bool:
    return frontmatterField(dest, "name") == "reviewer" or frontmatterField(dest, "permission_mode") == "plan"


def runTool(exe: str, *args: str) -> tuple[int, str]:
    result = subprocess.run([exe, *args], check=False, capture_output=True, text=True)
    return result.returncode, (result.stdout or result.stderr or "").strip()


def refreshLocalSkill() -> tuple[bool, str | None]:
    exe = shutil.which("local-skill")
    if not exe:
        return True, None
    code, text = runTool(exe, "refresh")
    if code != 0:
        return False, f"local-skill refresh 失败: {text or code}"
    return True, text or "local-skill refresh 完成"


def installPlugin(root: Path) -> tuple[bool, str]:
    exe = shutil.which("grok")
    if not exe:
        return False, "失败: 未找到 grok"
    code, text = runTool(exe, "plugin", "install", str(root), "--trust")
    if code != 0:
        return False, f"失败: {text or code}"
    return True, text or "ok"


def reviewContractStatus() -> tuple[bool, str]:
    exe = shutil.which("local-skill")
    if not exe:
        return False, f"local-skill: ⚠ 未在 PATH（keel-review 需要 `local-skill find {REVIEW_CONTRACT_SKILL}`）"
    code, text = runTool(exe, "find", REVIEW_CONTRACT_SKILL)
    if code != 0 or not text:
        return False, f"{REVIEW_CONTRACT_SKILL}: ⚠ `local-skill find {REVIEW_CONTRACT_SKILL}` 未找到，keel-review 会 BLOCKED"
    return True, f"{REVIEW_CONTRACT_SKILL}: ok ({exe})"


def binDir(args: argparse.Namespace, home: Path) -> Path:
    return Path(args.bin_dir).expanduser() if args.bin_dir else home / ".local" / "bin"


def commandInstall(args: argparse.Namespace) -> int:
    home = homeDir(args.home)
    state = State.load(home)
    root = repoRoot(state)
    state.root = str(root)
    skills = listSkills(root)
    lines = [f"source: {root / 'skills'} ({len(skills)})"]
    problems = 0
    for skill in skills:
        for host in hosts(home):
            if not host.required and not host.detect.is_dir():
                continue
            dest = host.parent / skill.name
            how = mount(skill, dest, "skills", state, copy=args.copy)
            if how == "skip-exists":
                problems += 1
                lines.append(f"{host.name}/{skill.name}: skip {dest}（已存在且不是 keel）")
            else:
                lines.append(f"{host.name}/{skill.name}: {how} → {dest}")
    if (home / ".grok").is_dir():
        for agent in listAgents(root):
            dest = grokAgentDest(home, agent)
            how = mount(agent, dest, "agents", state, copy=args.copy)
            if how != "skip-exists":
                lines.append(f"grok-agent/{agent.stem}: {how} → {dest}")
            elif isLocalReviewerRole(dest):
                lines.append(f"grok-agent/{agent.stem}: skip {dest}（本机已有 reviewer 角色，保留）")
            else:
                problems += 1
                lines.append(f"grok-agent/{agent.stem}: skip {dest}（已存在且不是 keel）")
    binDest = binDir(args, home) / CLI_NAME
    how = mount(root / "bin" / CLI_NAME, binDest, "bin", state, copy=args.copy)
    if how == "skip-exists":
        problems += 1
        lines.append(f"bin: skip {binDest}（已存在且不是本 CLI）")
    else:
        lines.append(f"bin: {how} → {binDest}")
    state.save()
    ok, refreshed = refreshLocalSkill()
    if refreshed:
        lines.append(refreshed)
    if not ok:
        problems += 1
    if args.plugin:
        ok, text = installPlugin(root)
        lines.append(f"plugin: {text}")
        if not ok:
            problems += 1
    for line in lines:
        print(line)
    if problems:
        print(f"install: {problems} 项未完成", file=sys.stderr)
        return 1
    return 0


def commandUninstall(args: argparse.Namespace) -> int:
    home = homeDir(args.home)
    state = State.load(home)
    root = repoRoot(state)
    lines: list[str] = []
    for skill in listSkills(root):
        for host in hosts(home):
            dest = host.parent / skill.name
            how = unmount(dest, skill, "skills", state)
            if how == "absent" and not host.required and not host.detect.is_dir():
                continue
            lines.append(f"{host.name}/{skill.name}: {how} {dest}")
    grokHome = home / ".grok"
    for agent in listAgents(root):
        dest = grokAgentDest(home, agent)
        how = unmount(dest, agent, "agents", state)
        if how == "absent" and not grokHome.is_dir():
            continue
        lines.append(f"grok-agent/{agent.stem}: {how} {dest}")
    if not args.keep_bin:
        binDest = binDir(args, home) / CLI_NAME
        lines.append(f"bin: {unmount(binDest, root / 'bin' / CLI_NAME, 'bin', state)} {binDest}")
    if args.keep_bin:
        state.save()
    else:
        state.delete()
    _, refreshed = refreshLocalSkill()
    if refreshed:
        lines.append(refreshed)
    for line in lines:
        print(line)
    return 0


def _mountStatus(dest: Path, src: Path, kind: str, state: State) -> tuple[str, bool]:
    """Return (status text, isProblem) for one expected mount."""
    own = ownership(dest, src, kind, state)
    if own == OURS:
        if dest.is_symlink() and not dest.exists():
            return f"⚠ 悬空链接 {dest} → keel install", True
        return f"{'symlink' if dest.is_symlink() else 'copy'} {dest}", False
    if own == FOREIGN:
        return f"⚠ 占用且不是 keel {dest}", True
    return f"未安装 → keel install  ({dest})", True


def commandDoctor(args: argparse.Namespace) -> int:
    home = homeDir(args.home)
    state = State.load(home)
    lines: list[str] = []
    problems = 0
    try:
        root = repoRoot(state)
        skills = listSkills(root)
    except FileNotFoundError as exc:
        print(f"source: ⚠ {exc}")
        return 1
    lines.append(f"root: {root}")
    lines.append("skills: " + " ".join(path.name for path in skills))
    for skill in skills:
        for host in hosts(home):
            if not host.required and not host.detect.is_dir():
                continue
            text, bad = _mountStatus(host.parent / skill.name, skill, "skills", state)
            problems += bad
            lines.append(f"{host.name}/{skill.name}: {text}")
    agents = listAgents(root)
    if (home / ".grok").is_dir():
        if not agents:
            lines.append("grok-agent: 仓库没有 agents/*.md")
        for agent in agents:
            dest = grokAgentDest(home, agent)
            own = ownership(dest, agent, "agents", state)
            model = frontmatterField(dest, "model")
            if own == OURS and dest.exists():
                kind = "symlink" if dest.is_symlink() else "copy"
                extra = f" model={model}" if model else " 未绑模型（继承父会话）"
                lines.append(f"grok-agent/{agent.stem}: {kind} {dest}{extra}")
            elif own == FOREIGN and isLocalReviewerRole(dest):
                extra = f" model={model}" if model else " 未绑模型"
                lines.append(f"grok-agent/{agent.stem}: 本机已有 {dest}{extra}")
            else:
                text, _ = _mountStatus(dest, agent, "agents", state)
                problems += 1
                lines.append(f"grok-agent/{agent.stem}: {text}")
    elif agents:
        lines.append("grok-agent: 未探测到 ~/.grok")
    binDest = binDir(args, home) / CLI_NAME
    text, bad = _mountStatus(binDest, root / "bin" / CLI_NAME, "bin", state)
    problems += bad
    lines.append(f"bin: {text}")
    ok, text = reviewContractStatus()
    problems += not ok
    lines.append(text)
    for line in lines:
        print(line)
    if problems:
        print(f"doctor: {problems} 项需要处理", file=sys.stderr)
        return 1
    return 0


def commandCheck(args: argparse.Namespace) -> int:
    """Check a caller-supplied evidence index without contacting a platform."""
    import hashlib
    import re

    checks: list[dict] = []
    record_path = Path(args.record).expanduser().resolve()

    def result(name: str, ok: bool, reason: str, stage: str, status: str = "pass") -> None:
        checks.append({"id": name, "status": status if ok else "fail", "reason": reason,
                       "source": f"{record_path}#{name}", "next_stage": None if ok else stage,
                       "resume_when": None if ok else "修正该项及其原始证据后重新运行 check"})

    def emit() -> int:
        passed = all(c["status"] != "fail" for c in checks)
        report = {"schema_version": 1, "status": "PASS" if passed else "BLOCKED",
                  "issue": args.issue, "candidate_sha": args.candidate, "checks": checks}
        if args.json:
            print(json.dumps(report, ensure_ascii=False, indent=2))
        else:
            print(report["status"])
            for c in checks:
                print(f'{c["id"]}: {c["status"]} — {c["reason"]}')
                if c["next_stage"]:
                    print(f'  → {c["next_stage"]}: {c["resume_when"]}')
        return 0 if passed else 1

    def no_duplicates(pairs: list) -> dict:
        value: dict = {}
        for key, item in pairs:
            if key in value:
                raise ValueError(f"重复 JSON 字段: {key}")
            value[key] = item
        return value

    def text(value: object) -> bool:
        return isinstance(value, str) and bool(value.strip())

    def evidence(value: object) -> bool:
        if not isinstance(value, dict) or not text(value.get("path")):
            return False
        digest = value.get("sha256")
        if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest):
            return False
        path = Path(value["path"])
        if not path.is_absolute():
            path = record_path.parent / path
        try:
            return path.is_file() and hashlib.sha256(path.read_bytes()).hexdigest() == digest
        except (OSError, ValueError):
            return False

    def gate(name: str, value: object, stage: str, *, candidate: bool = True,
             allow_skip: bool = False) -> dict:
        item = value if isinstance(value, dict) else {}
        state = item.get("status")
        valid = state == "pass" or (state == "skip" and allow_skip and text(item.get("reason")))
        reason = "要求 pass；允许的 skip 须有非空理由" if allow_skip else "要求 pass"
        if state == "skip" and text(item.get("reason")):
            reason += f"；skip: {item['reason']}"
        result(name + ".status", bool(valid), reason, stage, "skip" if state == "skip" else "pass")
        if candidate:
            result(name + ".candidate", item.get("candidate_sha") == args.candidate,
                   "证据候选版本须与调用方指定版本一致", stage)
        result(name + ".evidence", evidence(item.get("evidence")),
               "原始证据须为可读文件且 SHA-256 匹配（不认证作者或内容真实性）", stage)
        return item

    expected = args.stories.split(",")
    valid_input = (args.issue > 0 and bool(re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", args.candidate))
                   and all(re.fullmatch(r"S[1-9][0-9]*", s) for s in expected)
                   and len(set(expected)) == len(expected)
                   and all(text(s) for s in args.required_ci)
                   and len(set(args.required_ci)) == len(args.required_ci))
    result("input", valid_input, "issue 为正整数；候选为完整 SHA；Stories/必需 CI 无重复", "keel-issue")
    if not valid_input:
        return emit()
    try:
        data = json.loads(record_path.read_text(encoding="utf-8"), object_pairs_hook=no_duplicates)
        if not isinstance(data, dict):
            raise ValueError("索引必须为 JSON 对象")
    except (OSError, ValueError, RecursionError) as exc:
        result("record", False, f"无法读取索引：{exc}", "keel-issue")
        return emit()
    result("schema", type(data.get("schema_version")) is int and data["schema_version"] == 1,
           "只接受 schema_version=1", "keel-issue")
    result("issue", type(data.get("issue")) is int and data["issue"] == args.issue,
           "Issue 须与调用方指定编号一致", "keel-issue")
    result("candidate", data.get("candidate_sha") == args.candidate,
           "索引须对应调用方当前候选版本", "keel-dev")
    design = gate("design", data.get("design"), "keel-design", candidate=False, allow_skip=True)
    result("design.version", design.get("status") == "skip" or text(design.get("version")),
           "适用设计须指明获批版本；批准与版本的真实性由调用方核对", "keel-design")
    stories = data.get("stories")
    rows = stories if isinstance(stories, list) else []
    ids = [s.get("id") if isinstance(s, dict) else None for s in rows]
    result("stories", ids == expected, "验收行须与调用方 Stories 的编号、顺序、数量完全一致", "keel-dev")
    for n, row in enumerate(rows):
        gate(f"stories.{n + 1}", row, "keel-dev", allow_skip=True)
    verify = data.get("verify")
    path_type = verify.get("user_path") if isinstance(verify, dict) else None
    result("verify.user_path", path_type in ("cli", "gui", "none"),
           "用户路径分类必须为 cli / gui / none", "keel-verify")
    gate("verify", verify, "keel-verify", allow_skip=path_type == "none")
    review = data.get("review")
    review = review if isinstance(review, dict) else {}
    result("review.status", review.get("status") == "PASS", "独立审查须 PASS", "keel-review")
    result("review.human", review.get("human") == "optional", "human 须为 optional；required 交人处理", "keel-review")
    result("review.origin", text(review.get("reviewer_host")) and text(review.get("reviewer_model"))
           and review.get("source") in ("user", "bind-file", "host-config", "complementary"),
           "须有宿主、模型和合法来源字段；独立性由调用方核对", "keel-review")
    result("review.candidate", review.get("candidate_sha") == args.candidate,
           "审查须对应当前候选版本", "keel-review")
    result("review.evidence", evidence(review.get("evidence")), "审查原始证据可读且摘要一致", "keel-review")
    ci = data.get("ci")
    ci = ci if isinstance(ci, dict) else {}
    gate("ci", ci, "keel-release", allow_skip=not args.required_ci)
    ci_rows = ci.get("checks")
    ci_rows = ci_rows if isinstance(ci_rows, list) else []
    names = [c.get("name") if isinstance(c, dict) else None for c in ci_rows]
    valid_names = all(text(n) for n in names)
    result("ci.checks", isinstance(ci.get("checks"), list) and valid_names
           and (len(set(names)) == len(names) if valid_names else False)
           and all(n in names for n in args.required_ci)
           and (bool(names) if ci.get("status") == "pass" else not names),
           "必需 CI 不得缺失或重复；无 CI 必须显式 skip 并提供依据", "keel-release")
    for n, row in enumerate(ci_rows):
        gate(f"ci.{n + 1}", row, "keel-release")
    return emit()


def buildParser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="keel",
        description="把 keel 路由与环节 skill 安装到本机 coding agent 与 local-skill 库。",
    )
    parser.add_argument("--home", help="覆盖家目录（测试用；也可用 KEEL_HOME）")
    parser.add_argument("--bin-dir", help="CLI 安装目录，默认 ~/.local/bin")
    sub = parser.add_subparsers(dest="command", required=True)

    install = sub.add_parser("install", help="挂载全部 skill 并安装 CLI；有任何跳过或失败则退出码 1")
    install.add_argument("--copy", action="store_true", help="复制文件，不建符号链接")
    install.add_argument("--plugin", action="store_true", help="同时 grok plugin install --trust")
    install.set_defaults(handler=commandInstall)

    uninstall = sub.add_parser("uninstall", help="只移除 keel 自己挂上的链接或副本")
    uninstall.add_argument("--keep-bin", action="store_true", help="保留 ~/.local/bin/keel")
    uninstall.set_defaults(handler=commandUninstall)

    doctor = sub.add_parser("doctor", help="只读检查挂载状态；有任何缺失或占用则退出码 1")
    doctor.set_defaults(handler=commandDoctor)
    check = sub.add_parser("check", help="只读校验交付证据索引；不连接平台、不执行 CI 或合入")
    check.add_argument("record", help="JSON 索引文件；相对证据路径以该文件所在目录为准")
    check.add_argument("--issue", required=True, type=int, help="调用方从任务确认的 Issue 编号")
    check.add_argument("--candidate", required=True, help="调用方取得的当前完整候选 SHA")
    check.add_argument("--stories", required=True, help="任务验收编号，按顺序逗号分隔，如 S1,S2")
    check.add_argument("--required-ci", action="append", default=[], help="调用方确认的必需 CI 名称，可重复；不传表示无必需项")
    check.add_argument("--json", action="store_true", help="输出机器可读结果")
    check.set_defaults(handler=commandCheck)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = buildParser()
    args = parser.parse_args(argv)
    try:
        return int(args.handler(args))
    except (FileNotFoundError, OSError, RuntimeError) as exc:
        print(str(exc), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
